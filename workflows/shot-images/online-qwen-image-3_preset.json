      "model.height": { "from": "computed:height", "cast": "int" },
      "n": { "from": "literal:1", "cast": "int" },
      "seed": { "from": "option:seed", "default": "random_int31", "cast": "int" }
    }
  },
  "sizing": { "type": "image", "base": 1024, "snap": 16 }
