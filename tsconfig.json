{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@jtydhr88/pentrado": ["packages/pentrado/src/index.ts"],
      "@jtydhr88/pentrado/*": ["packages/pentrado/src/*"],
      "@/*": ["src/*"],
      "@agent/*": ["src/agent/host/*"],
      "@comfyorg/tailwind-utils": ["src/agent/host/tailwind-utils.ts"],
      "@comfyorg/ingest-types": ["src/agent/host/ingest-types/index.ts"],
      "@comfyorg/ingest-types/zod": ["src/agent/host/ingest-types/zod.gen.ts"],
      "@comfyorg/shared-frontend-utils/formatUtil": ["src/agent/host/utils/formatUtil.ts"],
      "shiki": ["src/agent/host/shiki.ts"]
    }
  },
  "include": [
    "src/**/*.ts", "src/**/*.d.ts", "src/**/*.tsx", "src/**/*.vue",
    "packages/*/src/**/*.ts", "packages/*/src/**/*.vue"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}
