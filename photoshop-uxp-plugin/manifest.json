{
  "manifestVersion": 5,
  "id": "com.comfytv.photoshop.uxp",
  "name": "ComfyTV",
  "version": "0.3.9",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "26.0.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "com.comfytv.photoshop.panel",
      "label": {
        "default": "Ai Panel"
      },
      "minimumSize": {
        "width": 300,
        "height": 420
      },
      "maximumSize": {
        "width": 1600,
        "height": 2000
      },
      "preferredDockedSize": {
        "width": 360,
        "height": 640
      },
      "preferredFloatingSize": {
        "width": 420,
        "height": 720
      }
    },
    {
      "type": "panel",
      "id": "com.comfytv.photoshop.history",
      "label": {
        "default": "ComfyTV 历史记录"
      },
      "minimumSize": {
        "width": 420,
        "height": 320
      },
      "maximumSize": {
        "width": 2000,
        "height": 2000
      },
      "preferredDockedSize": {
        "width": 640,
        "height": 560
      },
      "preferredFloatingSize": {
        "width": 920,
        "height": 700
      }
    },
    {
      "type": "panel",
      "id": "com.comfytv.photoshop.web",
      "label": {
        "default": "ComfyUI"
      },
      "minimumSize": {
        "width": 320,
        "height": 240
      },
      "maximumSize": {
        "width": 2000,
        "height": 2000
      },
      "preferredDockedSize": {
        "width": 900,
        "height": 640
      },
      "preferredFloatingSize": {
        "width": 1200,
        "height": 800
      }
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "request",
    "ipc": {
      "enablePluginCommunication": true
    },
    "launchProcess": {
      "schemes": [
        "http",
        "https"
      ],
      "extensions": [
        ".exe",
        ".ccx"
      ]
    },
    "webview": {
      "allow": "yes",
      "allowLocalRendering": "yes",
      "enableMessageBridge": "localAndRemote",
      "domains": [
        "http://localhost:8188",
        "http://127.0.0.1:8188",
        "http://localhost:8189",
        "http://127.0.0.1:8189",
        "http://localhost:8190",
        "http://127.0.0.1:8190",
        "http://localhost:8000",
        "http://127.0.0.1:8000",
        "http://localhost:3000",
        "http://127.0.0.1:3000"
      ]
    },
    "network": {
      "domains": "all"
    }
  }
}
